    // DQ-WT-001 — Web Tables: Lấy Email theo First Name
    // =============================
    @DataProvider(name = "firstNameEmail")
    public Object[][] firstNameEmail() {
        return new Object[][] {
                {"Cierra", "cierra@example.com"},
                // Có thể thêm hàng khác nếu bạn seed thêm data
        };
    }

    @Test(priority = 2, groups = {"elements", "webtables"}, dataProvider = "firstNameEmail",
          description = "DQ-WT-001 | Elements > Web Tables | Get email by First Name")
    public void tc_DQ_WT_001_GetEmailByFirstName(String firstName, String expectedEmail) {
        Log.info("=== START: DQ-WT-001 ===");
        webTablesPage.openWebTablesPage();

        String actualEmail = webTablesPage.getEmailByFirstName(firstName);
        Log.info("Email lấy được: " + actualEmail);

        AssertUtils.assertEquals(actualEmail, expectedEmail, "Email hiển thị không khớp UI.");
        Log.info("KẾT QUẢ: Email khớp UI.");
        Log.info("=== END: DQ-WT-001 ===");
    }

